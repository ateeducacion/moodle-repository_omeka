{
    "name": "moodle/repository-omeka",
    "type": "moodle-plugin",
    "description": "Moodle repository plugin to browse and download items from an Omeka-S instance.",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Area de Tecnologia Educativa",
            "email": "ate.educacion@gobiernodecanarias.org"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "moodlehq/moodle-cs": "^3.4",
        "phpmd/phpmd": "^2.15"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs -d memory_limit=1G",
        "fix": "phpcbf -d memory_limit=1G",
        "phpmd": "phpmd classes,lib.php,version.php,ajax.php,db text cleancode,codesize,controversial,design,naming,unusedcode",
        "test": "phpunit",
        "behat": "behat --config behat.yml"
    }
}
